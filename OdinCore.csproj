<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>OdinCore</PackageId>
    <Version>1.0.0</Version>
    <Authors>Amindada021</Authors>
    <Title>OdinCore</Title>
    <Description>A lightweight request-to-result pipeline for ASP.NET Core with validation, DI auto-registration, caching, paging, and HTTP result mapping.</Description>
    <PackageTags>odin;pipeline;request-handler;aspnetcore;dotnet;dependency-injection;caching;paging</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Amindada021/OdinCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Amindada021/OdinCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
